<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Juan Caramba Live Overlay</title>
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body {
            width: 1080px;
            height: 1920px;
            overflow: hidden;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: url('/juan-caramba-bg.jpg') no-repeat center center;
            background-size: cover;
            color: #ffffff;
        }

        /* Panel Izquierdo: Cola de Preguntas con animación de entrada */
        .queue-container {
            position: absolute;
            left: 40px;
            top: 150px;
            width: 380px;
            height: 1550px;
            background: rgba(0, 0, 0, 0.7);
            border: 2px solid rgba(255, 204, 0, 0.4);
            border-radius: 20px;
            padding: 20px;
            backdrop-filter: blur(12px);
            box-shadow: 0 10px 30px rgba(0,0,0,0.5);
        }
        .queue-title {
            font-size: 24px;
            font-weight: bold;
            margin-bottom: 20px;
            letter-spacing: 1px;
            color: #ffcc00;
            border-bottom: 2px solid rgba(255,204,0,0.3);
            padding-bottom: 10px;
            text-align: center;
        }
        .queue-list {
            list-style: none;
        }
        .queue-item {
            display: flex;
            align-items: center;
            background: rgba(255, 255, 255, 0.08);
            margin-bottom: 12px;
            padding: 12px 15px;
            border-radius: 12px;
            font-size: 22px;
            border-left: 4px solid #ffcc00;
            animation: fadeIn 0.5s ease-in-out;
        }
        .queue-item span {
            font-weight: bold;
            margin-right: 15px;
            color: #ffcc00;
        }

        /* Panel Superior Derecho: Lectura Actual con brillo dinámico */
        .current-reading {
            position: absolute;
            right: 40px;
            top: 150px;
            width: 550px;
            background: rgba(20, 20, 20, 0.85);
            border: 2px solid rgba(212, 175, 55, 0.8);
            border-radius: 20px;
            padding: 25px;
            backdrop-filter: blur(12px);
            box-shadow: 0 0 25px rgba(212, 175, 55, 0.3);
            animation: pulseGlow 3s infinite alternate;
        }
        .current-title {
            font-size: 20px;
            color: #d4af37;
            font-weight: bold;
            margin-bottom: 10px;
            letter-spacing: 1px;
            text-align: center;
        }
        .current-desc {
            font-size: 24px;
            font-weight: 600;
            line-height: 1.4;
            text-align: center;
        }

        /* Animaciones para mantener la pantalla viva para TikTok */
        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: translateY(0); }
        }
        @keyframes pulseGlow {
            0% { border-color: rgba(212, 175, 55, 0.5); box-shadow: 0 0 15px rgba(212, 175, 55, 0.2); }
            100% { border-color: rgba(212, 175, 55, 1); box-shadow: 0 0 30px rgba(212, 175, 55, 0.6); }
        }
    </style>
</head>
<body>

    <div class="queue-container">
        <div class="queue-title">✦ COLA DE PREGUNTAS ✦</div>
        <ul id="queueList" class="queue-list"></ul>
    </div>

    <div class="current-reading">
        <div class="current-title">✦ JUAN CARAMBA TAROT VIVO ✦</div>
        <div id="currentDesc" class="current-desc">Conectando con el más allá...</div>
    </div>

    <script src="/socket.io/socket.io.js"></script>
    <script>
        const socket = io();

        socket.on('updateOverlay', (data) => {
            const listEl = document.getElementById('queueList');
            listEl.innerHTML = '';
            data.queue.forEach((item, index) => {
                const li = document.createElement('li');
                li.className = 'queue-item';
                li.innerHTML = `<span>${index + 1}.</span> ${item.user}`;
                listEl.appendChild(li);
            });

            const readingEl = document.getElementById('currentDesc');
            readingEl.innerHTML = `<span style="color: #ffcc00; font-size: 22px; display: block; margin-bottom: 5px;">Lecura para: ${data.currentReading.user}</span>"${data.currentReading.question}"`;
        });
    </script>
</body>
</html>

